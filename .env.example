# ===================================================
# Environment Variables for DoctorApp
# Copy this file to .env and fill in your values
# ===================================================

# Database
DB_URL=jdbc:mysql://localhost:3306/doctor_app?createDatabaseIfNotExist=true&useSSL=false&serverTimezone=UTC&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=your_db_password

# JWT
JWT_SECRET=your_jwt_secret_key_at_least_32_bytes

# Email (Gmail SMTP)
MAIL_USERNAME=your_email@gmail.com
MAIL_PASSWORD=your_gmail_app_password
